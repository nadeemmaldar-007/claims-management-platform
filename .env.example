# Copy this file to .env to change a value; docker compose reads .env automatically.
# Every value below is the default that docker-compose.yml uses when the variable is not set.
# These are local-development values only.

# Database user and password: used by the postgres container and by the application.
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Secret that signs the tokens (at least 32 bytes). CHANGE IT for anything that is not a local run.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Demo accounts and policies (13 users), and the four sample claims (created only when there are no claims).
SEED_DEMO_DATA=true
SEED_SAMPLE_CLAIMS=true

# Port on your machine for the application. The container always listens on 8080 inside.
APP_PORT=8080
